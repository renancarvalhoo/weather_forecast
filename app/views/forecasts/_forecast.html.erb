<% forecast = result.forecast %>
<section class="mt-8">
  <div class="flex flex-wrap items-start justify-between gap-3">
    <div>
      <p class="text-sm text-slate-500"><%= t(".forecast_for") %></p>
      <p class="font-medium"><%= location.address %></p>
    </div>
    <%= render "cache_badge", location:, result: %>
  </div>

  <div class="mt-6 flex items-center gap-5 rounded-xl bg-white p-6 shadow-sm ring-1 ring-slate-200">
    <span class="text-6xl" aria-hidden="true"><%= weather_icon(forecast.current_weather_code) %></span>
    <div>
      <p class="text-5xl font-semibold tabular-nums"><%= fahrenheit(forecast.current_temperature) %>°F <span class="text-2xl font-normal text-slate-500"><%= forecast.current_temperature.round %>°C</span></p>
      <p class="mt-1 text-slate-600">
        <%= weather_description(forecast.current_weather_code) %> ·
        <%= t(".high", temperature: temperature(forecast.today.high)) %> ·
        <%= t(".low", temperature: temperature(forecast.today.low)) %>
      </p>
    </div>
  </div>

  <h2 class="mt-8 text-lg font-semibold"><%= t(".extended") %></h2>
  <ol class="mt-3 divide-y divide-slate-200 rounded-xl bg-white shadow-sm ring-1 ring-slate-200">
    <% forecast.daily.each do |day| %>
      <li class="flex items-center gap-4 px-5 py-3">
        <span class="w-24 font-medium"><%= day.date.strftime("%a %b %-d") %></span>
        <span class="text-2xl" aria-hidden="true"><%= weather_icon(day.weather_code) %></span>
        <span class="flex-1 text-slate-600"><%= weather_description(day.weather_code) %></span>
        <span class="tabular-nums"><%= temperature(day.high) %> · <%= temperature(day.low) %></span>
      </li>
    <% end %>
  </ol>
</section>
